# Copia este archivo como "application-local.properties" (git lo ignora) y ejecuta con el perfil "local".
# Así puedes poner tus credenciales sin subirlas a GitHub.

# --- MySQL local ---
spring.datasource.url=jdbc:mysql://localhost:3306/musicmania?sslMode=PREFERRED&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=tu_contraseña

